  "keyDecisions": [
    {
      "id": "decision-two-parks",
      "decision": "集中彭奇国家公园与坎哈国家公园两园，各连续住5晚，规划各4次野生动物观赏。",
      "reason": "以野生动物观察为主，并减少跨园搬迁；坎哈国家公园兼顾硬地沼鹿及森林生态观察。",
      "tradeoff": "不安排已游览过的主流古迹，也不叠加第三个保护区；野生动物目击仍有不确定性。"
    },
    {
      "id": "decision-child-pace",
      "decision": "每个活动日最多一场日间野生动物观赏，四人独用一辆持证吉普。",
      "reason": "州规则支持5—12岁儿童取得独立座位；独用车辆便于全家共同提前结束活动。",
      "tradeoff": "每人价格和儿童计费须另报价；包车不自动适用单座儿童半价，另聘酒店自然向导是否占座须确认。"
    },
    {
      "id": "decision-gates",
      "decision": "彭奇国家公园固定图里亚入口；坎哈国家公园固定穆基入口，仅2月1日上午申请坎哈核心区，其余申请穆基核心区。",
      "reason": "避免把不同入口和旅游分区混淆；官方规定从穆基进入坎哈分区只能参加上午场。",
      "tradeoff": "实际分区和路线以许可证为准，不能为了追逐目击临时跨门或越区。"
    },
    {
      "id": "decision-midweek",
      "decision": "1月27日与2月3日均安排上午场，周三下午休息。",
      "reason": "官方门户提示周三半日休园，彭奇国家公园官方常见问题明确为下午；具体许可仍须复核。",
      "tradeoff": "减少下午可选时段，核心区余票不足时可能减少场次或改合规缓冲区。"
    },
    {
      "id": "decision-transport",
      "decision": "广州经德里衔接那格浦尔，首晚德里、返程前一晚那格浦尔；地面使用带司机包车。",
      "reason": "入境后隔夜再接国内航班，长距离公路转场与国际返程分日安排。",
      "tradeoff": "增加两个过渡酒店夜；冬季航班及道路延误仍需备用航段和可退改条件。"
    },
    {
      "id": "decision-budget",
      "decision": "按两间房、12个酒店夜和8次四人独用吉普索取分项报价，以含10%机动金不超过100000元为采购上限。",
      "reason": "用户预算为50000—100000元；门票、车辆、向导、接送与餐食必须核对是否包含，防止重复计费。",
      "tradeoff": "报价前不承诺预算可达；如超上限，先调整酒店档次与附加服务，再按预案减少一场野生动物观赏。"
    }
  ],

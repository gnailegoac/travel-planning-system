    {
      "id": "flight-routing",
      "decision": "香港直飞仙台，返程从成田直飞成都天府。",
      "reason": "仙台入境后搭新干线，首晚到青森。查到的川航成田直飞班表在 2 月 1 日周一没有这班，2 月 2 日周二有班，整段顺延一天仍住七晚。",
      "tradeoff": "首日傍晚抵达青森，订房时保留晚到入住。秋田到成田的铁路和国际航班分两天完成。"
    },
    {
      "id": "route-coast",
      "decision": "把五能线白神号排成青森到秋田的单程转场。",
      "reason": "2 号上午行经鰺泽、千叠敷、深浦等海岸段。海、雪、车窗与便当集中在同一天，四个人可尝试订同一个海侧卡座。",
      "tradeoff": "全程 5 小时 20 分钟。当天午后只留秋田站边的可取消活动，两名孩子可在车上吃点心和休息。"
    },
    {
      "id": "city-selection",
      "decision": "青森 3 晚、秋田 3 晚、成田 1 晚。",
      "reason": "青森两天可按天气互换八甲田与弘前，秋田保留周六雪地动物园，周日只排市内半天。",
      "tradeoff": "仙台只换乘。浅虫水族馆为青森天气备选。"
    },
    {
      "id": "rail-tickets",
      "decision": "两段新干线按单买指定席；1 月 28–29 日比较五能线两日票，再单买白神号指定席。",
      "reason": "两日票可用于弘前往返和白神号的乘车券部分，白神号四人座位单独订。1 月 26 日仙台至新青森与 2 月 1 日秋田至东京分别按单程指定席估算。",
      "tradeoff": "白神号是主要体验，优先确认四人座位。五能线两日票可到青森站购票窗口或符合条件的设备办理，改行程时按实际乘车方案重算。"
    }
  ],

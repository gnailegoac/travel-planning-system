  "keyDecisions": [
    {
      "id": "arrive-one-day-earlier",
      "decision": "提前至 9 月 23 日抵达阿勒泰",
      "reason": "9 月 23 日进禾木、9 月 24 日进喀纳斯，均早于 9 月 25—27 日中秋假期；新增一天主要用于减少入园与换乘的不确定性，并把喀纳斯恢复为两晚。",
      "tradeoff": "9 月 23 日落地后走阿禾公路仍是受时间约束的转场日，只精选 2—3 个正规观景停车点，不把它当成完整慢游日。"
    },
    {
      "id": "kanas-two-nights-old-village",
      "decision": "喀纳斯老村同一家住宿连住两晚",
      "reason": "老村更接近喀纳斯换乘中心、湖区和次日三湾线路，便于假期首日早出、午间回房避峰、傍晚再游；两晚也给观鱼台能见度留出第二次判断机会。",
      "tradeoff": "老村通常价格更高、主街较吵，因此选择靠近换乘中心但不正对主街的房间，并优先确认独立卫浴、供暖、热水和行李接送。"
    },
    {
      "id": "kanas-before-baihaba",
      "decision": "先游喀纳斯，再从贾登峪经铁贾公路前往白哈巴",
      "reason": "从白哈巴可以乘喀纳斯 3 路区间车进入喀纳斯，但自驾车只能停在白哈巴新村停车场，不能随游客穿行至喀纳斯；若先到白哈巴，之后必须返回取车。现在的顺序让人员和车辆路线连续，不产生取车回头路。",
      "tradeoff": "9 月 26 日必须在约 12:30 前从贾登峪驾车离开；若明显超时、天气转差或白哈巴手续未落实，当日取消铁贾与白哈巴。"
    },
    {
      "id": "include-tiejia-road",
      "decision": "将铁贾公路作为贾登峪至铁热克提的景观转场",
      "reason": "铁贾公路约 53.3 公里，正好衔接三湾出园、白哈巴和次日经哈巴河返阿勒泰，避免原路绕行；其价值来自沿途山林与自驾体验，而不只是缩短里程。",
      "tradeoff": "道路按山区三级公路设计，设计速度约 30 公里/小时；含弯道、观景和交通影响按 2.5—3 小时规划，只在正规停车点停留。"
    },
    {
      "id": "baihaba-one-night",
      "decision": "白哈巴只住一晚",
      "reason": "一晚可以覆盖傍晚、清晨和村落氛围；再住一晚会挤占喀纳斯完整体验或飞行缓冲。",
      "tradeoff": "旺季自驾受车辆预约、门票、边境通行证和现场管控共同约束。若只缺自驾车名额，可在确认白哈巴 1 路车去程及次日返程班次后把车停在铁热克提换乘；门票或边境通行证未落实则直接取消。"
    },
    {
      "id": "altay-before-flight",
      "decision": "9 月 27 日必须返回阿勒泰市住宿",
      "reason": "把山区降雪、浓雾、道路管制和中秋返程车流与 9 月 28 日 15:40 航班隔离。",
      "tradeoff": "9 月 27 日白哈巴晨游最迟约 09:30 结束，不增加沿途景点。"
    },
    {
      "id": "two-nights-tashkurgan",
      "decision": "塔县连住两晚，10 月 2 日保留为喀什人文游兼机动日",
      "reason": "把 G314 长途进山和盘龙古道拆开，降低高海拔叠加疲劳；10 月 2 日可吸收国庆期间道路延误。",
      "tradeoff": "不再增加塔莎古道、红其拉甫、慕士塔格冰川公园或莎车，以免削弱离境缓冲。"
    }
  ],
